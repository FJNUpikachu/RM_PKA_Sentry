<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Untitled">
    <ReactiveSequence>
      <SubRobotStatus topic_name="robot_status"
                      robot_status="{robot_status}"/>
      <SubGameStatus topic_name="game_status"
                     game_status="{game_status}"/>
      <SubRfidStatus topic_name="rfid_status"
                     rfid_status="{rfid_status}"/>
      <SubTowerStatus topic_name="tower_status"
                      tower_status="{tower_status}"/>
      <WhileDoElse>
        <IsGameTime message="{game_status}"
                    game_progress="4"/>
        <ReactiveSequence>
          <WhileDoElse>
            <AsyncFallback>
              <IsStatusBest message="{robot_status}"/>
              <AsyncSequence>
                <Inverter>
                  <IsRfidDetected message="{rfid_status}"/>
                </Inverter>
                <IsStatusMiddle message="{robot_status}"/>
              </AsyncSequence>
            </AsyncFallback>
            <WhileDoElse>
              <AsyncFallback>
                <IsOutpostOk message="{tower_status}"/>
                <CanOutpostRevive tower_message="{tower_status}"
                                  game_message="{game_status}"/>
              </AsyncFallback>
              <SendGoal goal_pose="4;0;0; 0;0;0;1"
                        action_name="navigate_to_pose"/>
              <SendGoal goal_pose="4;0;0; 0;0;0;1"
                        action_name="navigate_to_pose"/>
            </WhileDoElse>
            <SendGoal goal_pose="0;0;0; 0;0;0;1"
                      action_name="navigate_to_pose"/>
          </WhileDoElse>
          <WhileDoElse>
            <AsyncFallback>
              <IsOutpostRfid message="{rfid_status}"/>
              <IsBattleStatus message="{robot_status}"/>
            </AsyncFallback>
            <PoseSwitch Defend="1"
                        Attack="0"
                        Run="0"/>
            <PoseSwitch Defend="0"
                        Attack="0"
                        Run="1"/>
          </WhileDoElse>
        </ReactiveSequence>
        <SendGoal goal_pose="0;0;0; 0;0;0;1"
                  action_name="navigate_to_pose"/>
      </WhileDoElse>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="CanOutpostRevive"
            editable="true">
      <input_port name="tower_message"
                  default="{tower_status}"/>
      <input_port name="game_message"
                  default="{game_status}"/>
    </Action>
    <Action ID="IsBattleStatus"
            editable="true">
      <input_port name="message"
                  default="{robot_status}"/>
    </Action>
    <Action ID="IsGameTime"
            editable="true">
      <input_port name="message"
                  default="{game_status}"/>
      <input_port name="game_progress"
                  default="4"/>
    </Action>
    <Action ID="IsOutpostOk"
            editable="true">
      <input_port name="message"
                  default="{tower_status}"/>
    </Action>
    <Action ID="IsOutpostRfid"
            editable="true">
      <input_port name="message"
                  default="{rfid_status}"/>
    </Action>
    <Action ID="IsRfidDetected"
            editable="true">
      <input_port name="message"
                  default="{rfid_status}">port</input_port>
    </Action>
    <Action ID="IsStatusBest"
            editable="true">
      <input_port name="message"
                  default="{robot_status}"/>
    </Action>
    <Action ID="IsStatusMiddle"
            editable="true">
      <input_port name="message"
                  default="{robot_status}"/>
    </Action>
    <Action ID="PoseSwitch"
            editable="true">
      <input_port name="Defend"
                  default="0"/>
      <input_port name="Attack"
                  default="0"/>
      <input_port name="Run"
                  default="1"/>
    </Action>
    <Action ID="SendGoal"
            editable="true">
      <input_port name="goal_pose"
                  default="0;0;0; 0;0;0;1"/>
      <input_port name="action_name"
                  default="navigate_to_pose"/>
    </Action>
    <Action ID="SubGameStatus"
            editable="true">
      <input_port name="topic_name"
                  default="game_status"/>
      <output_port name="game_status"
                   default="{game_status}"/>
    </Action>
    <Action ID="SubRfidStatus"
            editable="true">
      <input_port name="topic_name"
                  default="rfid_status"/>
      <output_port name="rfid_status"
                   default="{rfid_status}"/>
    </Action>
    <Action ID="SubRobotStatus"
            editable="true">
      <input_port name="topic_name"
                  default="robot_status"/>
      <output_port name="robot_status"
                   default="{robot_status}"/>
    </Action>
    <Action ID="SubTowerStatus"
            editable="true">
      <input_port name="topic_name"
                  default="tower_status"/>
      <output_port name="tower_status"
                   default="{tower_status}"/>
    </Action>
  </TreeNodesModel>

</root>
